@echo off
if /i "%~1"=="--ce-modern-worker" goto :main
"%ComSpec%" /d /k ""%~f0" --ce-modern-worker"
exit /b

:main
setlocal
chcp 65001 >nul
set "CE_MODERN_SETUP=%USERPROFILE%\Downloads\CE-Modern-Setup"
set "CE_MODERN_ZIP=%CE_MODERN_SETUP%\CE-Modern-Windows.zip"
set "CE_MODERN_DEST=%CE_MODERN_SETUP%\extraido"
set "CE_MODERN_SHA256=@@SHA256@@"
set "CE_MODERN_URL=https://raw.githubusercontent.com/Leandroxx10/testerea/main/downloads/CE-Modern-Windows.zip"
echo.
echo CE MODERN - DOWNLOAD E INSTALACAO
 echo Este assistente baixa a extensao. O Cheat Engine precisa estar instalado.
echo Pasta do download: "%CE_MODERN_SETUP%"
echo.
if exist "%CE_MODERN_SETUP%" goto :ready
mkdir "%CE_MODERN_SETUP%"
if errorlevel 1 goto :folderfailure
:ready
set "CE_MODERN_LOG=%CE_MODERN_SETUP%\download.log"
echo ==== CE Modern - download %DATE% %TIME% ==== >"%CE_MODERN_LOG%"
where curl.exe >nul 2>&1
if errorlevel 1 goto :nocurl
where powershell.exe >nul 2>&1
if errorlevel 1 goto :nopowershell
echo Baixando o pacote do GitHub. Aguarde...
curl.exe --fail --location --retry 2 --connect-timeout 15 --max-time 120 "%CE_MODERN_URL%" --output "%CE_MODERN_ZIP%" >>"%CE_MODERN_LOG%" 2>&1
if errorlevel 1 goto :downloadfailure
echo Conferindo a integridade do arquivo...
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; if ((Get-FileHash -LiteralPath $env:CE_MODERN_ZIP -Algorithm SHA256).Hash -ne $env:CE_MODERN_SHA256) { throw 'O checksum do pacote nao corresponde. Baixe novamente o assistente atualizado.' }" >>"%CE_MODERN_LOG%" 2>&1
if errorlevel 1 goto :hashfailure
echo Extraindo os arquivos...
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; Expand-Archive -LiteralPath $env:CE_MODERN_ZIP -DestinationPath $env:CE_MODERN_DEST -Force" >>"%CE_MODERN_LOG%" 2>&1
if errorlevel 1 goto :extractfailure
if not exist "%CE_MODERN_DEST%\CE-Modern\Instalar.cmd" goto :extractfailure
echo Download e verificacao concluidos.
echo Abrindo o instalador. Ele pedira a pasta do Cheat Engine, se necessario.
call "%CE_MODERN_DEST%\CE-Modern\Instalar.cmd" --ce-modern-worker
if errorlevel 1 goto :installfailure
exit /b 0

:nocurl
echo ERRO: curl.exe nao esta disponivel neste Windows.
goto :failure
:nopowershell
echo ERRO: Windows PowerShell nao foi encontrado. Baixe e extraia o ZIP manualmente.
goto :failure
:folderfailure
echo ERRO: nao foi possivel criar a pasta do download. Confira suas permissoes.
pause
exit /b 1
:downloadfailure
echo ERRO: o download do GitHub falhou. Confira a conexao e o registro abaixo.
goto :failure
:hashfailure
echo ERRO: pacote diferente do esperado. Nenhum arquivo baixado foi executado.
echo Baixe novamente Baixar-CE-Modern.cmd para usar o pacote atual.
goto :failure
:extractfailure
echo ERRO: nao foi possivel extrair o ZIP. Confira o espaco em disco e o registro.
goto :failure
:installfailure
echo O download foi concluido, mas a instalacao nao foi concluida.
echo Se o destino for Program Files, execute este assistente como administrador.
goto :failure
:failure
echo.
echo Registro do download: "%CE_MODERN_LOG%"
echo O arquivo baixado, quando presente, fica em "%CE_MODERN_ZIP%".
echo A janela ficara aberta para voce ler ou copiar a mensagem de erro.
pause
exit /b 1
